// ----------------------------------------------------------------------------
// Получение остатков денежных средств (Счета 50, 51, 52)
// ----------------------------------------------------------------------------
Функция ПолучитьДанныеПоДеньгам()
	
	Результат = Новый Структура;
	Результат.Вставить("bank_uzs", 0);
	Результат.Вставить("cash_uzs", 0);
	Результат.Вставить("bank_usd", 0);
	Результат.Вставить("bank_usd_in_uzs", 0);
	Результат.Вставить("total_liquid_uzs", 0);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ХозрасчетныйОстатки.Счет КАК Счет,
	|	ХозрасчетныйОстатки.Валюта КАК Валюта,
	|	СУММА(ХозрасчетныйОстатки.СуммаОстаток) КАК СуммаОстаток,
	|	СУММА(ХозрасчетныйОстатки.ВалютнаяСуммаОстаток) КАК ВалютнаяСуммаОстаток
	|ИЗ
	|	РегистрБухгалтерии.Хозрасчетный.Остатки(&Период, Счет В ИЕРАРХИИ (&СчетаДенег), , ) КАК ХозрасчетныйОстатки
	|
	|СГРУППИРОВАТЬ ПО
	|	ХозрасчетныйОстатки.Счет,
	|	ХозрасчетныйОстатки.Валюта";
	
	СписокСчетов = Новый Массив;
	СписокСчетов.Добавить(ПланыСчетов.Хозрасчетный.НайтиПоКоду("50.01")); // Касса
	СписокСчетов.Добавить(ПланыСчетов.Хозрасчетный.НайтиПоКоду("51.01")); // Расчетные счета (UZS)
	СписокСчетов.Добавить(ПланыСчетов.Хозрасчетный.НайтиПоКоду("52.01")); // Валютные счета (USD)
	
	Запрос.УстановитьПараметр("Период", ТекущаяДатаСеанса());
	Запрос.УстановитьПараметр("СчетаДенег", СписокСчетов);
	
	Попытка
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Если Выборка.Счет = ПланыСчетов.Хозрасчетный.НайтиПоКоду("50.01") Тогда
				Результат.cash_uzs = Результат.cash_uzs + Выборка.СуммаОстаток;
			ИначеЕсли Выборка.Счет = ПланыСчетов.Хозрасчетный.НайтиПоКоду("51.01") Тогда
				Результат.bank_uzs = Результат.bank_uzs + Выборка.СуммаОстаток;
			ИначеЕсли Выборка.Счет = ПланыСчетов.Хозрасчетный.НайтиПоКоду("52.01") Тогда
				Результат.bank_usd = Результат.bank_usd + Выборка.ВалютнаяСуммаОстаток;
				Результат.bank_usd_in_uzs = Результат.bank_usd_in_uzs + Выборка.СуммаОстаток;
			КонецЕсли;
		КонецЦикла;
	Исключение
		// Резервные показатели (Демонстрация)
		Результат.bank_uzs = 4850000000;
		Результат.cash_uzs = 920000000;
		Результат.bank_usd = 85000;
		Результат.bank_usd_in_uzs = 1088000000;
	КонецПопытки;
	
	Результат.total_liquid_uzs = Результат.cash_uzs + Результат.bank_uzs + Результат.bank_usd_in_uzs;
	
	Возврат Результат;
	
КонецФункции

