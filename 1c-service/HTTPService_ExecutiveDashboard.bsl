// ============================================================================
// МОДУЛЬ HTTP-СЕРВИСА: ExecutiveDashboard (MEAT CITY)
// Корневой URL: meatcity/v1
// Шаблоны URL:
//   1. /summary       [GET] -> Обработчик: GetExecutiveSummary
//   2. /pnl           [GET] -> Обработчик: GetPnLData
//   3. /cash          [GET] -> Обработчик: GetCashAndBank
//   4. /debts-stock   [GET] -> Обработчик: GetDebtsAndStock
// ============================================================================

#Область ОбработчикиЗапросов

// ----------------------------------------------------------------------------
// 1. УЧРЕДИТЕЛЬСКАЯ СВОДКА (Summary: Cash + P&L + Risks)
// URL: /hs/meatcity/v1/summary
// ----------------------------------------------------------------------------
Функция GetExecutiveSummary(Запрос)
	
	УстановитьПривилегированныйРежим(Истина);
	
	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Ответ.Заголовки.Вставить("Access-Control-Allow-Origin", "*");
	
	Попытка
		Данные = Новый Структура;
		Данные.Вставить("company", "MEAT CITY");
		Данные.Вставить("generated_at", ТекущаяДатаСеанса());
		
		// 1. Деньги и Ликвидность
		Деньги = ПолучитьДанныеПоДеньгам();
		Данные.Вставить("cash_liquidity", Деньги);
		
		// 2. Текущие P&L показатели (Текущий месяц и YTD)
		ПНЛ = ПолучитьСводныеПоказателиПНЛ();
		Данные.Вставить("pnl_summary", ПНЛ);
		
		// 3. Риски и Запасы
		Риски = ПолучитьРискиИЗапасы();
		Данные.Вставить("risks_and_assets", Риски);
		
		// 4. Расчет Чистого Оборотного Капитала (NWC = Деньги + Дебиторка + Запасы - Кредиторка)
		NWC = (Деньги.total_liquid_uzs + Риски.receivables_total + Риски.stock_total) - Риски.payables_suppliers;
		Данные.Вставить("net_working_capital_uzs", NWC);
		
		СтрокаJSON = ПреобразоватьВJSON(Данные);
		Ответ.УстановитьТелоИзСтроки(СтрокаJSON);
		
	Исключение
		Ответ = СформироватьОтветОшибки(500, ОписаниеОшибки());
	КонецПопытки;
	
	Возврат Ответ;
	
КонецФункции

